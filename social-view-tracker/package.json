{
  "name": "social-view-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Track and analyze publicly available YouTube and Instagram engagement metrics.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
