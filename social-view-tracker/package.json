  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.60.0",
    "clsx": "^2.1.1",
    "ioredis": "^5.6.1",
    "jose": "^6.0.11",
    "lucide-react": "^0.454.0",
    "next": "16.3.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.6",
    "papaparse": "^5.5.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
